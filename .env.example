# Copy to .env.local and fill in real values. Never commit .env.local.
# All variables are server-only: do NOT add a NEXT_PUBLIC_ prefix.

# Storage backend: "supabase" (fail with 503 if credentials are missing) or "memory" (demo data, lost on restart).
# Leave empty to use Supabase when both credentials below are set, otherwise memory.
AAGEY_STORAGE=

# Supabase project URL (Dashboard → Project Settings → API / Data API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase secret key (sb_secret_...) or legacy service_role key. Server-only; bypasses RLS.
SUPABASE_SECRET_KEY=replace-with-your-secret-key

# Set to 1 to run the integration tests in tests/integration against the database above.
# They insert rows tagged "[aagey-integration-test]" and delete only those rows afterwards.
AAGEY_DB_TEST=
